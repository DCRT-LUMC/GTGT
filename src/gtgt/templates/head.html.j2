<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <meta name="google" content="notranslate">
  <title>{{'GTGT analysis results for ' + variant if variant else 'Genetic Therapy Generator Toolkit'}}</title>
  <link href="https://cdn.jsdelivr.net/npm/beercss@3.9.6/dist/cdn/beer.min.css" rel="stylesheet">
  <script type="module" src="https://cdn.jsdelivr.net/npm/beercss@3.9.6/dist/cdn/beer.min.js"></script>
  <script type="module" src="https://cdn.jsdelivr.net/npm/material-dynamic-colors@1.1.2/dist/cdn/material-dynamic-colors.min.js"></script>
  <script type="text/javascript">
    function activate_info() {
      // set all pages to inactive
      let pages = Array.from(document.getElementsByClassName('page'))
      for (index in pages) {
        let element = pages[index];
        element.classList.remove('active');
      }

      // set all information pages (help, development, disclaimer) to active
      let page_names = ['disclaimer', 'documentation', 'development'];
      for (index in page_names) {
        let element = document.getElementById(page_names[index]);
        element.classList.add('active');
      }

      // unset the selected color from the nav menu
      let nav_elements = Array.from(document.querySelectorAll('nav a'));
        for (index in nav_elements) {
          let element = nav_elements[index];
          element.classList.remove('active');
        }
    }
  </script>
  <script>

    function invalid(element, operation)
    {
      if (operation == "remove") {
        element.classList.remove("invalid");
      }
      if (operation == "add") {
        element.classList.add("invalid");
      }
    }

    function clearInvalidDNA()
    {
      invalid(document.getElementById('dna_hgvs_input'), "remove");
    }

    function clearInvalidRNA()
    {
      invalid(document.getElementById('rna_hgvs_input'), "remove");
    }

    async function dna_to_rna(query){
      const url = `https://mutalyzer.nl/api/dna_to_rna/${query}`;
      console.info(url);
      const response = await fetch(url);

      if (!response.ok) {
        throw new Error(`Response status for ${query}: ${response.status}`);
      }

      const result = await response.json();

      if ("description" in result) {
        return result['description'];
      }
      else {
        msg=result['custom']['errors'][0]['details'];
        throw new Error('Mutalyzer error: ${msg}');
      }
    }

    async function rna_input()
    {
      // Get the values from the DNA and RNA
      var dna = document.getElementById('dna_hgvs');
      var rna = document.getElementById('rna_hgvs');

      // If there is already something in the RNA input field we do not change it
      if (rna.value) {
        return
      }

      // Query mutalyzer for the RNA description
      var rna_description='';
      try {
        rna_description = await dna_to_rna(dna.value);
      }
      catch (error) {
        return;
      }

      console.info(`rna_description = ${rna_description}`);

      // Fill out the RNA description when succesfull
      rna.value = rna_description;
    }

    function submit()
    {
      // First, we check if all inputs are there
      let dna_hgvs = document.getElementById('dna_hgvs').value;
      let rna_hgvs = document.getElementById('rna_hgvs').value;

      console.log(dna_hgvs)
      console.log(rna_hgvs)

      if (!dna_hgvs) {
        invalid(document.getElementById("dna_hgvs_input"), "add");
      }
      if (!rna_hgvs) {
        invalid(document.getElementById("rna_hgvs_input"), "add");
      }

      // If any of the inputs are empty, scroll to top and exit
      if (!rna_hgvs || !dna_hgvs ) {
        // Scroll to the top
        window.scrollTo({top: 0, behaviour: 'smooth'});
        return;
      }
      // Hide the submit button and show the spinner
      document.getElementById('submitBtn').style.visibility='hidden';
      document.getElementById('submitSpinner').style.visibility='visible';

      // Get the  checkboxes
      var protein_domains = document.getElementById('protein_domains').checked
      var extended = document.getElementById('extended').checked
      //Get the DNA and RNA inputs
      var dna = document.getElementById('dna_hgvs').value;
      var rna = document.getElementById('rna_hgvs').value;
      // Redirect to the results page
      console.log("Redirecting");
      window.location = "?dna=" + dna + "&rna=" + rna + "&protein_domains=" + protein_domains + "&extended=" + extended;
    }

    function fillSearchField(dna_hgvs, rna_hgvs)
    {
      // Set the value in the text search field
      document.getElementById('dna_hgvs').value=dna_hgvs;
      document.getElementById('rna_hgvs').value=rna_hgvs;
      // Scroll to the top
      window.scrollTo({top: 0, behaviour: 'smooth'})
    }

    // Also trigger submit when the user presses enter in the text field
    document.addEventListener("keyup", function(event) {
      if (event.keyCode === 13) { //13 is enter}
        event.preventDefault();
        submit();
      }
    });
  </script>
</head>
