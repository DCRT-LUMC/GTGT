{% if results is defined %}
  <div id="home" class="page padding">
{% else %}
  <div id="home" class="page padding active">
{% endif %}
    <h5>Analyze variants</h5>
    <p>
    Welcome to the Genetic Therapy Generator Toolkit, please specify the DNA and RNA <a href="https://hgvs-nomenclature.org" class="link" target="_blank">HGVS description</a> of your allele of interest below:
    </p>

    <fieldset>
      <legend>Specify the DNA and RNA variant descriptions</legend>
      <div id="dna_hgvs_input" class="field border label">
        <input id="dna_hgvs" type="text" {{'value=' + '"' + dna + '"' if dna else 'value="NO DNEA"'}} onfocusin="clearInvalidDNA()" onfocusout="rna_input()">
        <label>DNA description</label>
      </div>
      <div id="rna_hgvs_input" class="field border label">
        <input id="rna_hgvs" type="text" {{'value=' + '"' + rna + '"' if rna else ''}} onfocusin="clearInvalidRNA();rna_input()">
        <label>RNA description</label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Select therapy analysis options</legend>
      <nav>
        <label class="checkbox">
          <input type="checkbox" id="protein_domains" {{ 'checked' if protein_domains }}>
          <span>Analyze protein domains</span>
        </label>
        <label class="checkbox">
          <input type="checkbox" id="extended" {{ 'checked' if extended }}>
          <span>Show all evaluated therapies</span>
        </label>
      </nav>
    </fieldset>

    <div>
      <progress id="submitSpinner" style="visibility:hidden"></progress>
      <button id="submitBtn" class="center" type="button" onclick="submit()" >Submit</button>
    </div>

    {% if error is defined %}
    <div id="error" class="active">
      <article>
        <details open>
          <summary>
            <p>
              <i>error</i>
              {{ error["summary"]}}
            </p>
          </summary>
          <code>{{ error["details"] }}</code>
        </details>
      </article>
    </div>
    {% endif %}

    <h5>Examples</h5>
    <p>The input must be two HGVS descriptions, for DNA and RNA, describing the allele you want to analyze.
    <table>
      <thead>
        <tr>
          <th>Variant</th>
          <th>Explanation</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><a class="link" onclick="fillSearchField('ENST00000375549.8:c.100del','ENST00000375549.8:r.100del')">ENST00000375549.8:c.100del</a></td>
          <td>Frameshift deletion in exon 2 of SHDH</td>
        </tr>
        <tr>
          <td><a class="link" onclick="fillSearchField('NC_000023.11(NM_004006.3):c.2500del','NC_000023.11(NM_004006.3):r.2500del')">NC_000023.11(NM_004006.3):c.2500del</a></td>
          <td>Frameshift deletion in exon 20 of DMD</td>
        </tr>
      </tbody>
    </table>
  </div>

